# מקומי: מריצים Postgres מקומי או מדביקים כאן את ה-DATABASE_URL הציבורי של Railway
DATABASE_URL=postgresql://user:pass@localhost:5432/merkaz

# מפתח לחתימת קוקי ההתחברות. ב-Railway מגדירים משתנה סביבה בשם הזה עם ערך אקראי ארוך.
SESSION_SECRET=change-me-to-a-long-random-string

# משתמש הבעלים (מנהל המערכת) הראשוני שנוצר בהרצת ה-seed. ה-email חייב להתאים
# לחשבון Google שאיתו נכנסים — התחברות סיסמה בוטלה, הכניסה היחידה היא Google.
# OWNER_PASSWORD עדיין נדרש ל-seed (נשמר כ-hash) אך אינו משמש להתחברות.
OWNER_NAME=יונתן
OWNER_EMAIL=yif.johnn@gmail.com
OWNER_PASSWORD=change-me

PORT=3000

# גיבוי חיצוני (Google Drive) — ראו README, סעיף "גיבוי". אם ריקים, הגיבוי
# החיצוני פשוט מדולג ושאר האפליקציה עובדת כרגיל.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# גיבוי מלא (כולל בייטים של קבצים מצורפים) ל-Cloudflare R2 — ראו README,
# סעיף "גיבוי". אם ריקים, הגיבוי המלא מדולג ושאר האפליקציה עובדת כרגיל.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# התחברות דרך Google (OAuth) — שיטת ההתחברות היחידה. אם ריקים אין דרך להיכנס
# (מסך הכניסה יציג הודעה). ליצור ב-Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (Web application), ולהוסיף ל-Authorized redirect URIs את
# <origin>/api/auth/google/callback (גם prod וגם http://localhost:3000).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# אופציונלי — אחרת נגזר מכתובת הבקשה:
GOOGLE_REDIRECT_URI=

# כניסת SSO מ-HUB (חתול פיננסי) — סוד משותף, זהה ל-MISSION_CONTROL_SSO_SECRET
# שמוגדר שם. אם ריק — הנתיב /api/auth/sso מחזיר 503 והכפתור ב-HUB מפנה למסך
# ההתחברות הרגיל. מינימום 16 תווים.
HUB_SSO_SECRET=

# אחסון המדיה (תמונות/סרטונים/קבצים) — bucket ציבורי נפרד ב-R2 (לא ה-bucket של
# הגיבויים!), אותו חשבון ואותם מפתחות R2_* שלמעלה. כל קובץ מקבל קישור ציבורי
# קבוע, וההעלאה ישירה מהדפדפן ל-R2. R2_PUBLIC_BASE_URL הוא הכתובת הציבורית
# (Public Development URL בסגנון https://pub-xxx.r2.dev, או דומיין מחובר), בלי /
# בסוף. ל-bucket צריך כלל CORS — ראו README, "אחסון מדיה".
# אם ריקים — הקבצים נשמרים במסד כמו קודם (עד 50MB), ופרסום לאינסטגרם חסום.
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
# גודל מקסימלי לקובץ ב-MB (ברירת מחדל 1024 = 1GB, תקרה 2047)
MAX_MEDIA_MB=
# מחיקה סופית מסל המחזור וסריקת יתומים רצות רק ב-NODE_ENV=production. מקומית —
# bucket נפרד, ו-1 כאן רק אם באמת רוצים לבדוק מחיקות (על bucket הפיתוח בלבד!).
MEDIA_SWEEP=

# ערוץ המייל: ניוזלטר נשלח דרך ה-HUB (חתול פיננסי) — אין צינור מייל מקומי.
# HUB_API_KEY זהה ל-MISSION_CONTROL_API_KEY שמוגדר ב-HUB. אם ריקים —
# ערוץ מסוג "ניוזלטר" מושבת לשליחה אוטומטית ושאר האפליקציה עובדת כרגיל.
HUB_API_URL=
HUB_API_KEY=
